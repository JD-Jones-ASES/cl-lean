  let x0 := (m ||| (m <<< 4160)) &&& 
  let x1 := (x0 ||| (x0 <<< 2080)) &&& 
  let x2 := (x1 ||| (x1 <<< 1040)) &&& 
  let x3 := (x2 ||| (x2 <<< 520)) &&& 
  let x4 := (x3 ||| (x3 <<< 260)) &&& 
  let x5 := (x4 ||| (x4 <<< 130)) &&& 
  let x6 := (x5 ||| (x5 <<< 65)) &&& 
  x6

