    (∃ i, (223:ℤ) ∣ v i) ∨ ∀ j, (223:ℤ) ∣ tightFiveMoment v j := by
  by_cases hv : ∃ i, (223:ℤ) ∣ v i
  · exact Or.inl hv
  · exact Or.inr (moment_cover_of_normalized 223 (by decide) normalized_cover
      v hl (by simpa using hv))

end LonelyRunner.ModularPairCover.Prime223
