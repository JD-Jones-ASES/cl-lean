def spread (m : ℕ) : ℕ :=
  let x0 := (m ||| (m <<< 1312)) &&& 
  let x1 := (x0 ||| (x0 <<< 656)) &&& 
  let x2 := (x1 ||| (x1 <<< 328)) &&& 
  let x3 := (x2 ||| (x2 <<< 164)) &&& 
  let x4 := (x3 ||| (x3 <<< 82)) &&& 
  let x5 := (x4 ||| (x4 <<< 41)) &&& 
  x5

def pairs (a : ℕ) : ℕ := masks a * spread (masks a)

def targets (c : ℕ) : ℕ :=
