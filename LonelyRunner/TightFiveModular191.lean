    (∃ i, (191:ℤ) ∣ v i) ∨ ∀ j, (191:ℤ) ∣ tightFiveMoment v j := by
  by_cases hv : ∃ i, (191:ℤ) ∣ v i
  · exact Or.inl hv
  · exact Or.inr (moment_cover_of_normalized 191 (by decide) normalized_cover
      v hl (by simpa using hv))

