/-- The finite certificate applies to every tight integer tuple. -/
theorem tight_cover (v : Fin 5 → ℤ) (hl : loneliness v=(1:ℝ)/6) :
    (∃ i, (101:ℤ) ∣ v i) ∨ ∀ j, (101:ℤ) ∣ tightFiveMoment v j := by
  by_cases hv : ∃ i, (101:ℤ) ∣ v i
  · exact Or.inl hv
  · exact Or.inr (moment_cover_of_normalized 101 (by decide) normalized_cover
      v hl (by simpa using hv))

