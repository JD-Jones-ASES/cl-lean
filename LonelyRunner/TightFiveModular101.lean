def spread (m : ℕ) : ℕ :=
  let x0 := (m ||| (m <<< 1600)) &&& 
  let x1 := (x0 ||| (x0 <<< 800)) &&& 
  let x2 := (x1 ||| (x1 <<< 400)) &&& 
  let x3 := (x2 ||| (x2 <<< 200)) &&& 
  let x4 := (x3 ||| (x3 <<< 100)) &&& 
  let x5 := (x4 ||| (x4 <<< 50)) &&& 
  x5

def pairs (a : ℕ) : ℕ := masks a * spread (masks a)

