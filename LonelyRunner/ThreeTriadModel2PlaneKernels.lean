theorem model2Planes_coverage : ∀ a∈model2Planes, ∃ q, a=model2PlaneRow q := by decide +kernel

/-- An actual parameter coordinate is eliminated by a unit coefficient.
Every integer solution, with no divisibility assumption, is represented. -/
theorem model2Plane_exhaustive (q : Fin 42) (x : Fin 3 → ℤ)
    (hz : (∑ j, model2PlaneRow q j*x j)=0) :
    threeTriadTuple 2 x=torusSpeeds (model2PlaneC q) (model2PlaneD q)
      (x (model2PlaneFree q 0)) (x (model2PlaneFree q 1)) := by
  fin_cases q <;> simp [model2PlaneRow,Fin.sum_univ_succ] at hz <;>
    funext i <;> fin_cases i <;>
    simp [threeTriadTuple,threeTriadMatrix,model2PlaneC,model2PlaneD,model2PlaneFree,
      torusSpeeds,Fin.sum_univ_succ] <;> omega

