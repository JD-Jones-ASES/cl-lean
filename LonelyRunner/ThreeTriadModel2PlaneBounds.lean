theorem finite41 : torusSmallCheck (model2PlaneC 41) (model2PlaneD 41) 5 17 18 witness41=true := by decide +kernel

theorem small41 (A B : ℤ) (hp : PrimitiveSpeeds (torusSpeeds (model2PlaneC 41) (model2PlaneD 41) A B))
    (hproper : ProperSpeeds (torusSpeeds (model2PlaneC 41) (model2PlaneD 41) A B))
    (hn : loneliness (torusSpeeds (model2PlaneC 41) (model2PlaneD 41) A B)<(1:ℝ)/6) :
    ∀ i, |torusSpeeds (model2PlaneC 41) (model2PlaneD 41) A B i|≤18 := by
  apply torusSmallCheck_sound (model2PlaneC 41) (model2PlaneD 41) 5 17 18 witness41
    ![(1/6),(2/9),(1/6)] ![(1/6),(1/6),(1/3)] ![0,0,-1,-1,0,0] ?_ ?_ ?_ ?_ ?_ finite41 A B
    (primitive_torus_parameters _ _ _ _ hp) hproper hn
  · intro j i
    fin_cases j <;> fin_cases i <;> norm_num [model2PlaneC,model2PlaneD]
  · intro j i
    fin_cases j <;> fin_cases i <;> norm_num [model2PlaneC,model2PlaneD]
  · norm_num
  · norm_num
  · norm_num


/-- Every proper primitive near-tight direction in all 42 planes has
maximum absolute speed at most 18. All integer parameters are covered. -/
theorem all_planes_small (q : Fin 42) (A B : ℤ)
    (hp : PrimitiveSpeeds (torusSpeeds (model2PlaneC q) (model2PlaneD q) A B))
    (hproper : ProperSpeeds (torusSpeeds (model2PlaneC q) (model2PlaneD q) A B))
